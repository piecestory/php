# Production settings for Hostinger. Copy to <deploy-path>/shared/.env on the server (chmod 600)
# and fill in the values marked «…». Never commit the filled-in file. See docs/03-deployment.md.

APP_NAME="Piece & Story"
APP_ENV=production
# php artisan key:generate --show   (run once, paste the result; never change it afterwards)
APP_KEY=«base64:…»
APP_DEBUG=false
APP_URL=https://«domain»
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
# Server errors and failed backups are emailed here (empty: the store email set in the admin).
ALERT_EMAIL=

# hPanel → Databases → MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=«u123456789_piecestory»
DB_USERNAME=«u123456789_piecestory»
DB_PASSWORD=«…»

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=piece_story_

# hPanel → Emails → info@«domain» → Connect apps & devices
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@«domain»
MAIL_PASSWORD=«…»
MAIL_FROM_ADDRESS="info@«domain»"
MAIL_FROM_NAME="${APP_NAME}"

# Payments: the test page is never available in production whatever this says.
PAYMENT_SANDBOX=false
# Add each provider's payment page origin when its account is activated (comma-separated).
PAYMENT_CHECKOUT_ORIGINS=

# Nightly backup (storage/app/backups, 14 days). Set only if mysqldump is not on the PATH.
BACKUP_KEEP_DAYS=14
BACKUP_MYSQLDUMP=
